<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef Name="BodyPartExpansionRepRoyaltyBase" ParentName="BodyPartBase" Abstract="True">
    <techLevel>Spacer</techLevel>
    <thingCategories>
      <li>BodyPartsRoyalty</li>
    </thingCategories>
    <graphicData>
      <texPath>Things/Item/Health/HealthItem</texPath>
      <color>(75,30,28)</color>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.80</drawSize>
    </graphicData>
    <statBases>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
  </ThingDef>

  <!-- Royalty Rep eye -->
  <HediffDef ParentName="AddedBodyPartBase">
    <defName>ExpansionRepRoyaltyEye</defName>
    <label>inquisitor eye</label>
    <labelNoun>an inquisitor eye</labelNoun>
    <description>TODO</description>
    <descriptionHyperlinks>
      <ThingDef>ExpansionRepRoyaltyEye</ThingDef>
    </descriptionHyperlinks>
    <spawnThingOnRemoved>ExpansionRepRoyaltyEye</spawnThingOnRemoved>
    <addedPartProps>
      <solid>true</solid>
      <partEfficiency>1.40</partEfficiency>
      <betterThanNatural>true</betterThanNatural>
    </addedPartProps>
    <renderNodeProperties>
      <li Class="PawnRenderNodeProperties_Eye">
        <workerClass>PawnRenderNodeWorker_HediffEye</workerClass>
        <texPath>Things/Pawn/Wounds/ExpansionRepRoyaltyEye</texPath>
        <parentTagDef>Head</parentTagDef>
        <drawSize>0.15</drawSize>
        <drawData>
          <defaultData>
            <layer>56</layer>
            <offset>(0, 0, -0.25)</offset>
          </defaultData>
          <dataWest>
            <flip>true</flip>
          </dataWest>
        </drawData>
      </li>
    </renderNodeProperties>
  </HediffDef>

  <ThingDef ParentName="BodyPartExpansionRepRoyaltyBase">
    <defName>ExpansionRepRoyaltyEye</defName>
    <label>inquisitor eye</label>
    <description>TODO</description>
    <descriptionHyperlinks><RecipeDef>InstallExpansionRepRoyaltyEye</RecipeDef></descriptionHyperlinks>
    <statBases>
      <MarketValue>2400</MarketValue>
      <Mass>0.3</Mass>
    </statBases>
    <thingSetMakerTags>
      <li>RewardStandardCore</li>
    </thingSetMakerTags>
  </ThingDef>

  <RecipeDef ParentName="SurgeryInstallBodyPartArtificialBase">
    <defName>InstallExpansionRepRoyaltyEye</defName>
    <label>install inquisitor eye</label>
    <description>Install an inquisitor eye.</description>
    <descriptionHyperlinks>
      <ThingDef>ExpansionRepRoyaltyEye</ThingDef>
      <HediffDef>ExpansionRepRoyaltyEye</HediffDef>
    </descriptionHyperlinks>
    <jobString>Installing inquisitor eye.</jobString>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>ExpansionRepRoyaltyEye</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>ExpansionRepRoyaltyEye</li>
      </thingDefs>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts>
      <li>Eye</li>
    </appliedOnFixedBodyParts>
    <addsHediff>ExpansionRepRoyaltyEye</addsHediff>
  </RecipeDef>

</Defs>