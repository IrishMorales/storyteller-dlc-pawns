<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Royalty Rep Dress Coat (Outer) -->

  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Apparel_DressCoatBelted</defName>
    <label>dress coat</label>
    <description>A belted dress coat suitable for a position of authority.</description>
    <possessionCount>1</possessionCount>
    <recipeMaker>
      <researchPrerequisite>NobleApparel</researchPrerequisite>
      <displayPriority>230</displayPriority>
    </recipeMaker>
    <graphicData>
      <texPath>StorytellerAndDLCPawns/Things/Pawn/Humanlike/Apparel/DressCoatBelted/DressCoatBelted</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.05</drawSize>
    </graphicData>
    <costStuffCount>80</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <thingCategories>
      <li>ApparelNoble</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToMake>13000</WorkToMake>
      <Mass>2</Mass>
      <StuffEffectMultiplierArmor>0.3</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.85</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.40</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>3</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.05</SlaveSuppressionOffset>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
      </bodyPartGroups>
      <wornGraphicPath>StorytellerAndDLCPawns/Things/Pawn/Humanlike/Apparel/DressCoatBelted/DressCoatBelted</wornGraphicPath>
      <gender>Male</gender>
      <layers>
        <li>Shell</li>
      </layers>
      <tags>
        <li>Royal</li>
        <li>RoyalTier5</li>
      </tags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
      <canBeGeneratedToSatisfyToxicEnvironmentResistance>false</canBeGeneratedToSatisfyToxicEnvironmentResistance>
    </apparel>
    <colorGenerator Class="ColorGenerator_StandardApparel" />
    <tradeTags>
      <li>Clothing</li>
    </tradeTags>
  </ThingDef>

