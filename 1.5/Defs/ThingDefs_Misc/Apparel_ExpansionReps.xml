<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Royalty Rep Inner Armor (Skin) -->

  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Apparel_SkinArmor</defName>
    <label>skin armor</label>
    <description>Skin-tight armor that offers protection by dispersing kinetic energy over its interlocking plasteel plates. While it is thin enough to be worn under clothing and other pieces of armor, it hinders movement and its interlocking plates must be carefully crafted to adapt to the wearer's body type.</description>
    <possessionCount>1</possessionCount>
    <techLevel>Spacer</techLevel>
    <recipeMaker>
      <researchPrerequisite>FlakArmor</researchPrerequisite>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <skillRequirements>
        <Crafting>10</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>FabricationBench</li>
      </recipeUsers>
      <displayPriority>220</displayPriority>
    </recipeMaker>
    <graphicData>
      <texPath>StorytellerAndDLCPawns/Things/Pawn/Humanlike/Apparel/SkinArmor/SkinArmor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costList>
      <ComponentSpacer>6</ComponentSpacer>
      <Cloth>30</Cloth>
      <Plasteel>40</Plasteel>
    </costList>
    <statBases>
      <WorkToMake>60000</WorkToMake>
      <MaxHitPoints>300</MaxHitPoints>
      <Mass>10</Mass>
      <Flammability>0.6</Flammability>
      <ArmorRating_Sharp>0.8</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
      <ArmorRating_Heat>0.3</ArmorRating_Heat>
      <Insulation_Cold>30</Insulation_Cold>
      <Insulation_Heat>10</Insulation_Heat>
      <EquipDelay>10</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>-0.2</MoveSpeed>
      <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.05</SlaveSuppressionOffset>
    </equippedStatOffsets>
    <apparel>
      <developmentalStageFilter>Adult</developmentalStageFilter>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
      </bodyPartGroups>
      <wornGraphicPath>StorytellerAndDLCPawns/Things/Pawn/Humanlike/Apparel/SkinArmor/SkinArmor</wornGraphicPath>
      <gender>Male</gender>
      <layers>
        <li>OnSkin</li>
      </layers>
      <tags>
        <li>SkinArmor</li>
      </tags>
      <useDeflectMetalEffect>true</useDeflectMetalEffect>
      <soundWear>Wear_PowerArmor</soundWear>
      <soundRemove>Remove_PowerArmor</soundRemove>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
      <canBeGeneratedToSatisfyToxicEnvironmentResistance>false</canBeGeneratedToSatisfyToxicEnvironmentResistance>
    </apparel>
    <colorGenerator Class="ColorGenerator_StandardApparel" />
    <tradeTags>
      <li>HiTechArmor</li>
    </tradeTags>
    <thingCategories>
      <li>ApparelArmor</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Biocodable"/>
    </comps>
    <thingSetMakerTags>
      <li>RewardStandardHighFreq</li>
    </thingSetMakerTags>
  </ThingDef>

  <!-- Royalty Rep Dress Coat (Outer) -->

