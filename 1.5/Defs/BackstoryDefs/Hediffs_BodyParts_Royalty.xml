<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef Name="BodyPartExpansionRepRoyaltyBase" ParentName="BodyPartBase" Abstract="True">
    <techLevel>Spacer</techLevel>
    <thingCategories>
      <li>BodyPartsArchotech</li>
    </thingCategories>
    <graphicData>
      <texPath>Things/Item/Health/HealthItem</texPath>
      <color>(75,30,28)</color>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.80</drawSize>
    </graphicData>
    <statBases>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
  </ThingDef>

  <!-- Royalty Rep eye -->

  <HediffDef ParentName="AddedBodyPartBase">
    <defName>ExpansionRepRoyaltyEye</defName>
    <label>inquisitor eye</label>
    <labelNoun>an inquisitor eye</labelNoun>
    <description>TODO</description>
    <descriptionHyperlinks>
      <ThingDef>ExpansionRepRoyaltyEye</ThingDef>
    </descriptionHyperlinks>
    <spawnThingOnRemoved>ExpansionRepRoyaltyEye</spawnThingOnRemoved>
    <addedPartProps>
      <solid>true</solid>
      <partEfficiency>1.40</partEfficiency>
      <betterThanNatural>true</betterThanNatural>
    </addedPartProps>
    <renderNodeProperties>
      <li Class="PawnRenderNodeProperties_Eye">
        <workerClass>PawnRenderNodeWorker_HediffEye</workerClass>
        <texPath>StorytellerAndDLCPawns/Things/Pawn/Wounds/ExpansionRepRoyaltyEye</texPath>
        <parentTagDef>Head</parentTagDef>
        <drawSize>0.13</drawSize>
        <drawData>
          <defaultData>
            <layer>70</layer>
            <offset>(-0.02, 0, -0.22)</offset>
          </defaultData>
          <dataWest>
            <flip>true</flip>
          </dataWest>
        </drawData>
      </li>
    </renderNodeProperties>
  </HediffDef>

  <ThingDef ParentName="BodyPartExpansionRepRoyaltyBase">
    <defName>ExpansionRepRoyaltyEye</defName>
    <label>inquisitor eye</label>
    <description>TODO</description>
    <descriptionHyperlinks>
      <RecipeDef>InstallExpansionRepRoyaltyEye</RecipeDef>
    </descriptionHyperlinks>
    <statBases>
      <MarketValue>2400</MarketValue>
      <Mass>0.3</Mass>
    </statBases>
    <techHediffsTags>
      <li>ExpansionRepRoyaltyEye</li>
    </techHediffsTags>
  </ThingDef>

  <RecipeDef ParentName="SurgeryInstallBodyPartArtificialBase">
    <defName>InstallExpansionRepRoyaltyEye</defName>
    <label>install inquisitor eye</label>
    <description>Install an inquisitor eye.</description>
    <descriptionHyperlinks>
      <ThingDef>ExpansionRepRoyaltyEye</ThingDef>
      <HediffDef>ExpansionRepRoyaltyEye</HediffDef>
    </descriptionHyperlinks>
    <jobString>Installing inquisitor eye.</jobString>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>ExpansionRepRoyaltyEye</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>ExpansionRepRoyaltyEye</li>
      </thingDefs>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts>
      <li>Eye</li>
    </appliedOnFixedBodyParts>
    <addsHediff>ExpansionRepRoyaltyEye</addsHediff>
  </RecipeDef>

  <!-- Royalty Rep forehead implant -->
   
  <HediffDef ParentName="AddedBodyPartBase">
    <defName>ExpansionRepRoyaltyForeheadEye</defName>
    <label>eye of foresight</label>
    <labelNoun>an eye of foresight</labelNoun>
    <description>This brain implant increases the user's psychic sensitivity and projects the user's mood in a large range, forcing others to feel a blurred, simplified version of the user's emotions. Given its power in psychic combat, it is only known to be crafted by the royal empire, who bestows it upon those with the title of royal inquisitor.</description>
    <descriptionHyperlinks>
      <ThingDef>ExpansionRepRoyaltyForeheadEye</ThingDef>
    </descriptionHyperlinks>
    <spawnThingOnRemoved>ExpansionRepRoyaltyForeheadEye</spawnThingOnRemoved>
    <addedPartProps>
      <solid>true</solid>
      <partEfficiency>1.40</partEfficiency>
      <betterThanNatural>true</betterThanNatural>
    </addedPartProps>
    <stages>
      <li>
        <statOffsets>
          <PsychicSensitivity>0.3</PsychicSensitivity>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_PsychicHarmonizer">
        <range>100</range>
        <thought>PsychicHarmonization</thought>
      </li>
    </comps>
    <renderNodeProperties>
      <li>
        <workerClass>PawnRenderNodeWorker_Head</workerClass>
        <texPath>StorytellerAndDLCPawns/Things/Pawn/Wounds/ExpansionRepRoyaltyForeheadEye</texPath>
        <parentTagDef>Head</parentTagDef>
        <drawSize>0.15</drawSize>
        <drawData>
          <defaultData>
            <layer>56</layer>
            <offset>(0, 0, -0.295)</offset>
          </defaultData>
          <dataWest>
            <flip>false</flip>
          </dataWest>
        </drawData>
      </li>
    </renderNodeProperties>
  </HediffDef>

  <ThingDef ParentName="BodyPartExpansionRepRoyaltyBase">
    <defName>ExpansionRepRoyaltyForeheadEye</defName>
    <label>eye of foresight</label>
    <description>TODO</description>
    <descriptionHyperlinks>
      <RecipeDef>InstallExpansionRepRoyaltyForeheadEye</RecipeDef>
    </descriptionHyperlinks>
    <statBases>
      <MarketValue>2400</MarketValue>
      <Mass>0.3</Mass>
    </statBases>
    <techHediffsTags>
      <li>ExpansionRepRoyaltyForeheadEye</li>
    </techHediffsTags>
  </ThingDef>

  <RecipeDef ParentName="SurgeryInstallBodyPartArtificialBase">
    <defName>InstallExpansionRepRoyaltyForeheadEye</defName>
    <label>install eye of foresight</label>
    <description>Install an eye of foresight.</description>
    <descriptionHyperlinks>
      <ThingDef>ExpansionRepRoyaltyForeheadEye</ThingDef>
      <HediffDef>ExpansionRepRoyaltyForeheadEye</HediffDef>
    </descriptionHyperlinks>
    <jobString>Installing eye of foresight.</jobString>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>ExpansionRepRoyaltyForeheadEye</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>ExpansionRepRoyaltyForeheadEye</li>
      </thingDefs>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts>
      <li>Brain</li>
    </appliedOnFixedBodyParts>
    <addsHediff>ExpansionRepRoyaltyForeheadEye</addsHediff>
  </RecipeDef>

</Defs>