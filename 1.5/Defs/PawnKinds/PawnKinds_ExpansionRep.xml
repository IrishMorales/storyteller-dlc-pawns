<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- Base class for expansion reps -->
    <PawnKindDef Name="ExpansionRepBase" Abstract="True">
        <studiableAsPrisoner>false</studiableAsPrisoner>
        <isBoss>false</isBoss>
        <allowOldAgeInjuries>true</allowOldAgeInjuries>
        <canStrip>true</canStrip>
        <hostileToAll>false</hostileToAll>
        <initialResistanceRange>10~20</initialResistanceRange>
        <initialWillRange>3~5</initialWillRange>
        <immuneToGameConditionEffects>false</immuneToGameConditionEffects>
        <immuneToTraps>false</immuneToTraps>
        <ignoresPainShock>false</ignoresPainShock>
        <isFighter>true</isFighter>
        <combatPower>140</combatPower>
        <maxPerGroup>1</maxPerGroup>
        <itemQuality>Normal</itemQuality>
        <forceWeaponQuality>Normal</forceWeaponQuality>
        <minApparelQuality>Normal</minApparelQuality>
        <maxApparelQuality>Excellent</maxApparelQuality>
    </PawnKindDef>

    <!-- Royalty Rep -->
    <PawnKindDef MayRequire="Ludeon.RimWorld.Royalty" ParentName="RoyalUpperBase" Inherit="False">
        <defName>ExpansionRep_Royalty</defName>
        <label>royal inquisitor</label>
        <labelPlural>royal inquisitors</labelPlural>
        <titleRequired>Duke</titleRequired>
        <combatPower>135</combatPower>
        <apparelMoney>9999999</apparelMoney>
        <race>Human</race>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>ImperialRoyal</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>ExpansionRepRoyalty</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
        <!-- <forcedHair></forcedHair> -->
        <!-- <forcedHairColor></forcedHairColor> -->
        <!-- <forcedTraits></forcedTraits> -->
        <fixedChildBackstories></fixedChildBackstories>
        <fixedAdultBackstories></fixedAdultBackstories>
        <fixedGender>Male</fixedGender>
        <!-- <weaponStuffOverride></weaponStuffOverride> -->
        <!-- <weaponStyleDef></weaponStyleDef> -->
        <!-- <apparelRequired></apparelRequired> -->
        <!-- <apparelColor></apparelColor> -->
        <minGenerationAge>50</minGenerationAge>
        <maxGenerationAge>80</maxGenerationAge>
        <specificApparelRequirements>
            <li>
                <bodyPartGroup>UpperHead</bodyPartGroup>
                <requiredTag>RoyalTier6</requiredTag>
                <stuff>Plasteel</stuff>
            </li>
            <li>
                <bodyPartGroup>Torso</bodyPartGroup>
                <apparelLayer>Middle</apparelLayer>
                <requiredTag>RoyalTier5</requiredTag>
                <color>(55,55,55)</color>
            </li>
            <li>
                <bodyPartGroup>Torso</bodyPartGroup>
                <apparelLayer>OnSkin</apparelLayer>
                <requiredTag>RoyalTier2</requiredTag>
                <color>(104, 85, 227)</color>
            </li>
            <li>
                <bodyPartGroup>Torso</bodyPartGroup>
                <apparelLayer>Shell</apparelLayer>
                <requiredTag>RoyalTier6</requiredTag>
                <color>(104, 85, 227)</color>
                <alternateTagChoices>
                    <li>
                        <tag>Cape</tag>
                        <chance>0.5</chance>
                    </li>
                </alternateTagChoices>
            </li>
        </specificApparelRequirements>
        <techHediffsChance>0.25</techHediffsChance>
        <techHediffsMoney>1000~2500</techHediffsMoney>
        <techHediffsMaxAmount>2</techHediffsMaxAmount>
        <initialWillRange>14~17</initialWillRange>
        <initialResistanceRange>38~58</initialResistanceRange>
        <useFactionXenotypes>false</useFactionXenotypes>
        <xenotypeSet>
            <xenotypeChances>
                <Baseliner MayRequire="Ludeon.RimWorld.Biotech">1</Baseliner>
            </xenotypeChances>
        </xenotypeSet>
    </PawnKindDef>

