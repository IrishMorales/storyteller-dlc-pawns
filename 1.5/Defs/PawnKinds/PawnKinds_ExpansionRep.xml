<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- Base class for expansion reps -->
    <PawnKindDef Name="ExpansionRepBase" Abstract="True">
        <studiableAsPrisoner>false</studiableAsPrisoner>
        <isBoss>false</isBoss>
        <allowOldAgeInjuries>true</allowOldAgeInjuries>
        <canStrip>true</canStrip>
        <hostileToAll>false</hostileToAll>
        <initialResistanceRange>10~20</initialResistanceRange>
        <initialWillRange>3~5</initialWillRange>
        <immuneToGameConditionEffects>false</immuneToGameConditionEffects>
        <immuneToTraps>false</immuneToTraps>
        <ignoresPainShock>false</ignoresPainShock>
        <isFighter>true</isFighter>
        <combatPower>140</combatPower>
        <itemQuality>Normal</itemQuality>
        <forceWeaponQuality>Normal</forceWeaponQuality>
        <minApparelQuality>Normal</minApparelQuality>
        <maxApparelQuality>Excellent</maxApparelQuality>
    </PawnKindDef>

    <!-- Royalty Rep -->
    <PawnKindDef MayRequire="Ludeon.RimWorld.Royalty" ParentName="RoyalBase" Inherit="False">
        <defName>ExpansionRep_Royalty</defName>
        <label>royal inquisitor</label>
        <labelPlural>royal inquisitors</labelPlural>
        <titleRequired>Duke</titleRequired>
        <factionHostileOnDeath>true</factionHostileOnDeath>
        <combatPower>135</combatPower>
        <race>Human</race>
        <fixedGender>Male</fixedGender>
        <maxPerGroup>1</maxPerGroup>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>ImperialRoyal</li>
                </categoriesChildhood>
            </li>
        </backstoryFiltersOverride>
        <!-- forces only backstories with the body type "Male" -->
        <fixedAdultBackstories>
            <li>Spymaster41</li>
            <li>Landworker98</li>
            <li>RoyalGuard51</li>
            <li>MilitaryChaplain10</li>
            <li>Demolitionist39</li>
            <li>InfantryOfficer49</li>
            <li>Deserter65</li>
            <li>IntelligenceAgent21</li>
            <li>MilitaryCook18</li>
            <li>InfantryMedic6</li>
            <li>InfantryEngineer46</li>
            <li>PiousSoldier67</li>
        </fixedAdultBackstories>
        <!-- TODO: fix - doesn't reflect in-game -->
        <skinColorOverride>(95, 65, 55)</skinColorOverride>
        <forcedHair>LionsMane</forcedHair>
        <forcedHairColor>(50, 50, 52)</forcedHairColor>
        <!-- TODO: Replace with unique weapon (chalice) -->
        <!-- <weaponTags>
            <li>EltexStaff</li>
        </weaponTags> -->
        <minGenerationAge>40</minGenerationAge>
        <maxGenerationAge>70</maxGenerationAge>
        <apparelMoney>9999999</apparelMoney>
        <specificApparelRequirements>
            <!-- TODO: Replace with unique headgear -->
            <li>
                <bodyPartGroup>Torso</bodyPartGroup>
                <apparelLayer>Shell</apparelLayer>
                <requiredTag>DressCoatBelted</requiredTag>
                <stuff>Cloth</stuff>
                <color>(255,255,255)</color>
            </li>
            <li>
                <bodyPartGroup>Torso</bodyPartGroup>
                <apparelLayer>Middle</apparelLayer>
                <apparelDef>Apparel_PsyfocusVest</apparelDef>
                <stuff>Cloth</stuff>
                <color>(40, 28, 21)</color>
            </li>
            <li>
                <bodyPartGroup>Torso</bodyPartGroup>
                <apparelLayer>OnSkin</apparelLayer>
                <apparelDef>Apparel_CollarShirt</apparelDef>
                <stuff>Cloth</stuff>
                <color>(32, 31, 27)</color>
            </li>
        </specificApparelRequirements>
        <techHediffsChance>1</techHediffsChance>
        <techHediffsMoney>9999~9999</techHediffsMoney>
        <techHediffsMaxAmount>2</techHediffsMaxAmount>
        <techHediffsTags>
            <li>ExpansionRepRoyaltyEye</li>
            <li>ExpansionRepRoyaltyForeheadEye</li>
        </techHediffsTags>
        <initialWillRange>14~17</initialWillRange>
        <initialResistanceRange>38~58</initialResistanceRange>
        <useFactionXenotypes>false</useFactionXenotypes>
        <xenotypeSet>
            <xenotypeChances>
                <Baseliner MayRequire="Ludeon.RimWorld.Biotech">1</Baseliner>
            </xenotypeChances>
        </xenotypeSet>
        <requiredWorkTags>
            <li>Violent</li>
        </requiredWorkTags>
    </PawnKindDef>

